{
  "format": "db-flow",
  "version": 2,
  "name": "Blink: blinkende LED",
  "kind": "arduino",
  "arduino": {
    "board": "uno",
    "baud": 9600,
    "pins": [
      {
        "name": "LED",
        "pin": "13",
        "mode": "output",
        "component": "led"
      }
    ]
  },
  "setup": [],
  "body": [
    {
      "id": "b1",
      "t": "digitalWrite",
      "pin": "LED",
      "value": "HIGH"
    },
    {
      "id": "b2",
      "t": "delay",
      "ms": "500"
    },
    {
      "id": "b3",
      "t": "digitalWrite",
      "pin": "LED",
      "value": "LOW"
    },
    {
      "id": "b4",
      "t": "delay",
      "ms": "500"
    }
  ]
}
