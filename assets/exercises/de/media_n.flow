{
  "format": "db-flow",
  "version": 2,
  "name": "Mittelwert von n Zahlen",
  "kind": "algorithm",
  "body": [],
  "exercise": {
    "text": "Lies ein, wie viele Zahlen folgen (n, mindestens 1), dann die n Kommazahlen, und gib ihren Mittelwert aus. Gib nur das Ergebnis aus.",
    "locked": true,
    "cases": [
      {
        "in": [
          "3",
          "4",
          "5",
          "6"
        ],
        "out": [
          "5"
        ]
      },
      {
        "in": [
          "2",
          "1",
          "2"
        ],
        "out": [
          "1.5"
        ]
      },
      {
        "in": [
          "4",
          "10",
          "0",
          "0",
          "0"
        ],
        "out": [
          "2.5"
        ],
        "hidden": true
      },
      {
        "in": [
          "1",
          "-7.5"
        ],
        "out": [
          "-7.5"
        ],
        "hidden": true
      }
    ]
  }
}
