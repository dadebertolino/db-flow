{
  "format": "db-flow",
  "version": 2,
  "name": "Count the positives",
  "kind": "algorithm",
  "body": [],
  "exercise": {
    "text": "Read integers until 0 is entered, then output how many were positive (the final 0 does not count). Output only the result.",
    "locked": true,
    "cases": [
      {
        "in": [
          "5",
          "-2",
          "3",
          "0"
        ],
        "out": [
          "2"
        ]
      },
      {
        "in": [
          "0"
        ],
        "out": [
          "0"
        ]
      },
      {
        "in": [
          "-1",
          "-2",
          "0"
        ],
        "out": [
          "0"
        ],
        "hidden": true
      },
      {
        "in": [
          "1",
          "1",
          "1",
          "1",
          "0"
        ],
        "out": [
          "4"
        ],
        "hidden": true
      }
    ]
  }
}
