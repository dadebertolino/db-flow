        ],
        "out": [
          "3",
          "2",
          "1"
        ]
      },
      {
        "in": [
          "1"
        ],
        "out": [
          "1"
        ]
      },
      {
        "in": [
          "5"
        ],
        "out": [
          "5",
          "4",
          "3",
          "2",
          "1"
        ],
        "hidden": true
      }
    ]
  }
