      },
      {
        "in": [
          "7",
          "7",
          "2"
        ],
        "out": [
          "7"
        ]
      },
      {
        "in": [
          "-1",
          "-5",
          "-3"
        ],
        "out": [
          "-1"
        ],
        "hidden": true
      },
      {
        "in": [
          "1",
          "2",
          "8"
        ],
        "out": [
          "8"
        ],
        "hidden": true
      },
      {
        "in": [
          "0",
          "0",
          "0"
        ],
        "out": [
          "0"
        ],
        "hidden": true
      }
    ]
  }
