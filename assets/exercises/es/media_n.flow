{
  "format": "db-flow",
  "version": 2,
  "name": "Media de n números",
  "kind": "algorithm",
  "body": [],
  "exercise": {
    "text": "Lee cuántos números se van a introducir (n, al menos 1), luego los n números reales, y escribe su media. Escribe solo el resultado.",
    "locked": true,
    "cases": [
      {
        "in": [
          "3",
          "4",
          "5",
          "6"
        ],
        "out": [
          "5"
        ]
      },
      {
        "in": [
          "2",
          "1",
          "2"
        ],
        "out": [
          "1.5"
        ]
      },
      {
        "in": [
          "4",
          "10",
          "0",
          "0",
          "0"
        ],
        "out": [
          "2.5"
        ],
        "hidden": true
      },
      {
        "in": [
          "1",
          "-7.5"
        ],
        "out": [
          "-7.5"
        ],
        "hidden": true
      }
    ]
  }
}
