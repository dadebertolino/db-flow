    "cases": [
      {
        "in": [
          "3",
          "4"
        ],
        "out": [
          "12"
        ]
      },
      {
        "in": [
          "2.5",
          "2"
        ],
        "out": [
          "5"
        ]
      },
      {
        "in": [
          "0.5",
          "0.5"
        ],
        "out": [
          "0.25"
        ],
        "hidden": true
      },
      {
        "in": [
          "10",
          "0"
        ],
        "out": [
          "0"
        ],
        "hidden": true
      }
    ]
  }
