{
  "format": "db-flow",
  "version": 2,
  "name": "Compter les positifs",
  "kind": "algorithm",
  "body": [],
  "exercise": {
    "text": "Lisez des nombres entiers jusqu'à ce que 0 soit saisi, puis affichez combien étaient positifs (le 0 final ne compte pas). Affichez seulement le résultat.",
    "locked": true,
    "cases": [
      {
        "in": [
          "5",
          "-2",
          "3",
          "0"
        ],
        "out": [
          "2"
        ]
      },
      {
        "in": [
          "0"
        ],
        "out": [
          "0"
        ]
      },
      {
        "in": [
          "-1",
          "-2",
          "0"
        ],
        "out": [
          "0"
        ],
        "hidden": true
      },
      {
        "in": [
          "1",
          "1",
          "1",
          "1",
          "0"
        ],
        "out": [
          "4"
        ],
        "hidden": true
      }
    ]
  }
}
