        ],
        "out": [
          "vrai"
        ]
      },
      {
        "in": [
          "7"
        ],
        "out": [
          "faux"
        ]
      },
      {
        "in": [
          "0"
        ],
        "out": [
          "vrai"
        ],
        "hidden": true
      },
      {
        "in": [
          "-3"
        ],
        "out": [
          "faux"
        ],
        "hidden": true
      }
    ]
  }
